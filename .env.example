VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_FORMLY_ACCESS_KEY=your-formly-access-key
VITE_PRESENCE_API=your-presence-api-url (optional)
# Optional: Cloudflare Turnstile site key for the comment form. Leave empty to
# disable the widget; the submit-comment function only enforces it when
# TURNSTILE_SECRET is set on the project (they must be enabled together).
VITE_TURNSTILE_SITE_KEY=
# Function-side secrets (never in this file). Set with:
#   supabase secrets set COMMENT_HASH_SALT=<random 32+ chars> TURNSTILE_SECRET=<secret>
# NOTE: VITE_SUPABASE_PUBLISHABLE_KEY is legacy/unused — prefer ANON_KEY above.
# Never commit real keys: keep .env local (gitignored) and rotate any leaked secret.